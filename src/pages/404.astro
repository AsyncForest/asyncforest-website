---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Async Forest Advisory"
  description="That page doesn't exist. Find the audits, the process, or a way to get in touch."
>
  <section class="section">
    <div class="container container--narrow nf">
      <span class="eyebrow">404 — page not found</span>
      <h1>That page isn't here</h1>
      <p class="lede">
        The link is stale or the address has a typo. Nothing is broken on your
        end — here's where things actually live:
      </p>
      <ul class="nf__links">
        <li><a href="/services/">The three audits</a> — due diligence, AI readiness, AI-built app hardening</li>
        <li><a href="/how-it-works/">How an engagement runs</a> — scope to debrief, one meeting total</li>
        <li><a href="/about/">Who does the work</a></li>
      </ul>
      <a href="/" class="btn btn--primary">Go to the homepage</a>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: var(--space-12); }
  .nf__links {
    list-style: none;
    padding: 0;
    margin: var(--space-8) 0 var(--space-10);
  }
  .nf__links li {
    padding-block: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }
  .nf__links li:last-child { border-bottom: 1px solid var(--border-subtle); }
</style>
