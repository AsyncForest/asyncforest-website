---
import Base from '../layouts/Base.astro';
// [EMAIL SLOT] — confirm the address on the asyncforest domain, then update
// here and in SiteFooter.astro.
const EMAIL = 'henry@asyncforest.co.uk';
const SUBJECT = encodeURIComponent("The decision I'm facing");
---

<Base
  title="Contact — Async Forest"
  description="Tell me about the decision you're facing — a few sentences is plenty. I reply to everything within two working days."
>
  <section class="contact container container--narrow">
    <h1>Contact</h1>
    <p class="contact__lede">
      The fastest way to start is to tell me about the decision you're facing —
      a few sentences is plenty.
    </p>
    <p class="contact__email">
      <a href={`mailto:${EMAIL}?subject=${SUBJECT}`}>
        [EMAIL SLOT — address on asyncforest.co.uk]
      </a>
      <span class="contact__subject mono">suggested subject: "The decision I'm facing"</span>
    </p>
    <p class="contact__expectation">I reply to everything within two working days.</p>
  </section>
</Base>

<style>
  .contact {
    padding-block: var(--section-y);
    min-height: 50vh;
  }
  .contact__lede {
    font-size: var(--text-md);
    max-width: 58ch;
    margin-bottom: var(--space-10);
  }
  .contact__email {
    margin-bottom: var(--space-10);
  }
  .contact__email a {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }
  .contact__subject {
    display: block;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .contact__expectation {
    color: var(--text-muted);
  }
</style>
