---
import Base from '../layouts/Base.astro';
import HeroForest from '../components/HeroForest.astro';
import { BOOKING_URL } from '../consts';

const doors = [
  {
    question: 'Is it sound?',
    href: '/work/#assurance',
    body:
      'Technical due diligence and portfolio reviews, architecture and technology decision review, technology strategy audit. For investors and founders.',
  },
  {
    question: 'What should we do?',
    href: '/work/#sprints',
    body:
      'GenAI architecture, build-vs-buy, scale readiness, technical narratives. Best practices for production ML and GenAI are still emerging and volatile; I\'ll help you de-risk your approach.',
  },
  {
    question: 'What next?',
    href: '/work/#counsel',
    body:
      'The AI era changes fast enough that long-term decisions can feel impossible. I\'ll help you build durable, de-risked stability into your AI strategy and architecture.',
  },
];
---

<Base
  title="Async Forest — Henry Franks"
  description="I help companies and investors make high-stakes decisions about software and AI"
>
  <section class="hero">
    <HeroForest />
    <div class="hero__copy container">
      <p class="eyebrow">Software and AI advisory</p>
      <h1 class="hero__title">
        <span class="hero__line hero__line--1">See the forest</span>
        <span class="hero__line hero__line--2">and the trees</span>
      </h1>
      <p class="hero__sub">
        Dr Henry Franks, director of Async Forest Ltd, has spent two decades researching agentic systems, building production machine learning, and teaching responsible AI. I'll help you make the right decisions about your AI strategy and architecture.
      </p>
      <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">Get in touch about your project</a>
    </div>
  </section>

  <section class="doors container container--narrow" aria-label="Ways to work with me">
    <ol class="doors__list">
      {doors.map((d) => (
        <li class="door">
          <a class="door__link" href={d.href}>
            <span class="door__question">{d.question}</span>
            <span class="door__body">{d.body}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="close container container--narrow">
    <p>
      If you're facing one of these decisions, the fastest way to start is to
      tell me about it.
    </p>
    <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">Tell me about the decision you're facing</a>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 690px;
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    padding-top: var(--space-24);
  }
  .hero__copy .eyebrow {
    margin-bottom: var(--space-6);
  }
  .hero__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-8);
  }
  .hero__line {
    display: table; /* shrink-wraps each line into its own block */
    color: var(--gray-50);
    padding: var(--space-1) var(--space-5) var(--space-2);
  }
  .hero__line--1 { background: var(--accent-active); }
  .hero__line--2 {
    background: var(--accent);
    margin-left: var(--space-8);
    margin-top: var(--space-2);
  }
  .hero__sub {
    font-size: var(--text-md);
    color: var(--text-body);
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  /* The signature element: the three buyer questions as large, quiet type. */
  .doors {
    padding-block: var(--space-16);
  }
  .doors__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .door {
    margin: 0;
    border-top: 1px solid var(--border-default);
  }
  .door:last-child { border-bottom: 1px solid var(--border-default); }
  .door__link {
    display: block;
    padding-block: var(--space-10);
    text-decoration: none;
    color: inherit;
  }
  .door__question {
    display: block;
    font-size: clamp(var(--text-xl), 4.5vw, var(--text-3xl));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--text-strong);
    margin-bottom: var(--space-4);
    transition: color var(--duration-normal) var(--ease-out);
  }
  .door__body {
    display: block;
    max-width: 62ch;
    color: var(--text-muted);
  }
  .door__link:hover .door__question { color: var(--accent); }
  .door__link:focus-visible .door__question { color: var(--accent); }

  .close {
    padding-block: var(--space-16) var(--space-8);
  }
  .close p {
    font-size: var(--text-md);
    margin-bottom: var(--space-6);
  }
</style>
