---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 3);

const doors = [
  {
    question: '“Is it sound?”',
    href: '/work/#assurance',
    body:
      'Independent review of a system, codebase, or AI integration — a scope-limited written report with prioritised findings and a clear conclusion. For investors, boards, and anyone who needs verification rather than reassurance.',
  },
  {
    question: '“What should we do?”',
    href: '/work/#sprints',
    body:
      'A time-boxed advisory sprint built around one decision: GenAI architecture, build-vs-buy, scale readiness, pre-raise technical narrative. Options, trade-offs, and a written recommendation with reasons.',
  },
  {
    question: '“Keep us honest.”',
    href: '/work/#counsel',
    body:
      'Ongoing counsel for teams putting AI into production — a standing session, written answers to hard questions, an independent voice before the board meeting.',
  },
];
---

<Base
  title="Async Forest — Henry Franks"
  description="I help companies and investors make high-stakes decisions about software and AI — the kind you want to get right the first time."
>
  <section class="hero container container--narrow">
    <h1>
      I help companies and investors make high-stakes decisions about software
      and AI — the kind you want to get right the first time.
    </h1>
    <p class="hero__sub">
      Fifteen years as a startup CTO and chief architect; a PhD in trust in
      autonomous systems; guest lecturer on responsible AI at King's College
      London and Notre Dame.
    </p>
    <a class="btn btn--primary" href="/contact/">Tell me about the decision you're facing</a>
  </section>

  <section class="problem container container--narrow">
    <p>
      GenAI has made it cheap to build and expensive to be wrong. Demos ship in
      a weekend; the failures — cost blowouts, security holes, regulatory
      exposure, architectures that can't scale — surface after the money is
      committed. Internal teams grade their own homework, and AI tools tell you
      what you want to hear. At some point you need someone independent to
      actually look.
    </p>
  </section>

  <section class="doors container container--narrow" aria-label="Ways to work with me">
    <ol class="doors__list">
      {doors.map((d) => (
        <li class="door">
          <a class="door__link" href={d.href}>
            <span class="door__question">{d.question}</span>
            <span class="door__body">{d.body}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="writing container container--narrow" aria-labelledby="writing-heading">
    <h2 class="eyebrow" id="writing-heading">Selected writing</h2>
    <ul class="writing__list">
      {essays.map((essay) => (
        <li class="writing__item">
          <a class="writing__title" href={`/writing/${essay.id}/`}>{essay.data.title}</a>
          <p class="writing__standfirst">{essay.data.standfirst}</p>
        </li>
      ))}
    </ul>
    <p class="writing__more"><a href="/writing/">All writing</a></p>
  </section>

  <section class="close container container--narrow">
    <p>
      If you're facing one of these decisions, the fastest way to start is to
      tell me about it.
    </p>
    <a class="btn btn--primary" href="/contact/">Tell me about the decision you're facing</a>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--section-y) var(--space-16);
  }
  .hero h1 {
    max-width: 26ch;
    margin-bottom: var(--space-6);
  }
  .hero__sub {
    font-size: var(--text-md);
    color: var(--text-muted);
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  .problem {
    padding-block: var(--space-8);
  }
  .problem p {
    font-size: var(--text-md);
    max-width: 62ch;
  }

  /* The signature element: the three buyer questions as large, quiet type. */
  .doors {
    padding-block: var(--space-16);
  }
  .doors__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .door {
    margin: 0;
    border-top: 1px solid var(--border-default);
  }
  .door:last-child { border-bottom: 1px solid var(--border-default); }
  .door__link {
    display: block;
    padding-block: var(--space-10);
    text-decoration: none;
    color: inherit;
  }
  .door__question {
    display: block;
    font-size: clamp(var(--text-xl), 4.5vw, var(--text-3xl));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--text-strong);
    text-indent: -0.42em; /* hang the opening quote so the questions align */
    margin-bottom: var(--space-4);
    transition: color var(--duration-normal) var(--ease-out);
  }
  .door__body {
    display: block;
    max-width: 62ch;
    color: var(--text-muted);
  }
  .door__link:hover .door__question { color: var(--accent); }
  .door__link:focus-visible { box-shadow: none; }
  .door__link:focus-visible .door__question { color: var(--accent); }

  .writing {
    padding-block: var(--space-8);
  }
  .writing__list {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
  }
  .writing__item {
    margin: 0;
    padding-block: var(--space-5);
  }
  .writing__item + .writing__item { border-top: 1px solid var(--border-subtle); }
  .writing__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }
  .writing__title:hover { color: var(--accent); }
  .writing__standfirst {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
    font-size: var(--text-base);
  }
  .writing__more { font-size: var(--text-base); }

  .close {
    padding-block: var(--space-16) var(--space-8);
  }
  .close p {
    font-size: var(--text-md);
    margin-bottom: var(--space-6);
  }
</style>
