---
import Base from '../layouts/Base.astro';
import { BOOKING_URL } from '../consts';
---

<Base
  title="Work with me — Async Forest"
  description="Assurance, technical due diligence, advice and counsel."
>
  <section class="intro container container--narrow">
    <h1>Work with me</h1>
  </section>

  <section class="engagement container container--narrow" id="assurance" aria-labelledby="assurance-heading">
    <p class="engagement__question mono">Is it sound?</p>
    <h2 id="assurance-heading">Assurance &amp; due diligence</h2>
    <p>
        Technical due diligence and portfolio reviews, architecture & technology decision review, technology strategy audit.
    </p>
    <p class="engagement__price mono">For investors and founders</p>
  </section>

  <section class="engagement container container--narrow" id="sprints" aria-labelledby="sprints-heading">
    <p class="engagement__question mono">What should we do?</p>
    <h2 id="sprints-heading">AI/ML product consultation</h2>
    <p>GenAI architecture, build-vs-buy, scale readiness, technical narratives. Building data-dense production ML/GenAI distributed systems is hard, and best practices are still emerging, volatile, and have a steep learning curve. I'll help you de-risk your approach.
    </p>
    <p class="engagement__price mono">Decision support for your product and tech strategy</p>
  </section>

  <section class="engagement container container--narrow" id="counsel" aria-labelledby="counsel-heading">
    <p class="engagement__question mono">What next?</p>
    <h2 id="counsel-heading">Ongoing counsel</h2>
    <p>
      The AI era requires new approaches, but changes so fast it can feel impossible to make long term decisions. I'll help you build out long-term de-risked stability in your AI strategy and architecture.
    </p>
  </section>

  <section class="close container container--narrow">
    <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">Tell me about the decision you're facing</a>
  </section>
</Base>

<style>
  .intro {
    padding-block: var(--section-y) var(--space-8);
  }
  .intro p {
    font-size: var(--text-md);
    max-width: 62ch;
  }

  .engagement {
    padding-block: var(--space-8);
  }
  .engagement__inner-rule,
  .engagement__question {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-default);
  }
  .engagement__price {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .close {
    padding-block: var(--space-8);
  }
</style>
