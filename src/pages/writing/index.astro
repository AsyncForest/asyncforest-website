---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';

// Drafts show in dev only. No pagination until there are more than 20 posts.
const posts = (
  await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title="Writing — Async Forest"
  description="Essays on software, AI, and the judgement calls in between, by Henry Franks."
>
  <section class="intro container container--narrow">
    <h1>Writing</h1>
  </section>

  <section class="essays container container--narrow">
    <ul class="essays__list">
      {
        posts.map((post) => (
          <li class="essays__item">
            <div class="essays__meta mono">
              <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                {fmt.format(post.data.pubDate)}
              </time>
              {post.data.draft && <span class="essays__draft">draft</span>}
            </div>
            <a class="essays__title" href={`/writing/${post.id}/`}>
              {post.data.title}
            </a>
            <p class="essays__description">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
    <p class="essays__subscribe">
      <Subscribe />
    </p>
  </section>
</Base>

<style>
  .intro {
    padding-block: var(--section-y) var(--space-6);
  }

  .essays__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .essays__item {
    margin: 0;
    padding-block: var(--space-8);
  }
  .essays__item + .essays__item { border-top: 1px solid var(--border-subtle); }
  .essays__meta {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .essays__draft {
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--warning);
  }
  .essays__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }
  .essays__title:hover { color: var(--accent); }
  .essays__description {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
  }
  .essays__subscribe {
    margin-top: var(--space-6);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
