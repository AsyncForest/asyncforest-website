---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base title={`${essay.data.title} — Async Forest`} description={essay.data.standfirst} ogType="article">
  <article class="essay container">
    <header class="essay__header">
      <p class="essay__date mono">
        <time datetime={essay.data.date.toISOString().slice(0, 10)}>
          {fmt.format(essay.data.date)}
        </time>
      </p>
      <h1>{essay.data.title}</h1>
      <p class="essay__standfirst">{essay.data.standfirst}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="essay__close">
      <p>If this is the kind of question you're working through, get in touch.</p>
      <a class="btn btn--primary" href="/contact/">Tell me about the decision you're facing</a>
    </footer>
  </article>
</Base>

<style>
  .essay {
    max-width: calc(var(--container-prose) + 2 * var(--gutter));
    padding-block: var(--section-y) var(--space-8);
  }
  .essay__header {
    margin-bottom: var(--space-12);
  }
  .essay__date {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  .essay__standfirst {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  /* The flagship reading surface: generous measure, clear hierarchy,
     aside/footnote support, nothing else. */
  .prose :global(p),
  .prose :global(li) {
    max-width: var(--container-prose);
  }
  .prose :global(h2) {
    margin-top: var(--space-12);
  }
  .prose :global(h3) {
    margin-top: var(--space-8);
  }
  .prose :global(blockquote) {
    margin: var(--space-8) 0;
    padding-left: var(--space-6);
    border-left: 2px solid var(--border-strong);
    color: var(--text-muted);
  }
  .prose :global(blockquote p) {
    font-size: var(--text-md);
  }
  .prose :global(aside) {
    margin: var(--space-8) 0;
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-warm);
    font-size: var(--text-base);
    color: var(--text-muted);
  }
  .prose :global(.footnotes) {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-base);
    color: var(--text-muted);
  }
  .prose :global(.footnotes h2) {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .prose :global(sup a) {
    text-decoration: none;
    font-family: var(--font-mono);
  }
  .prose :global(hr) {
    width: var(--space-16);
    margin-inline: 0;
  }

  .essay__close {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-default);
  }
  .essay__close p {
    margin-bottom: var(--space-6);
  }
</style>
