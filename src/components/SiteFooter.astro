---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo size={26} />
        <p class="footer__strap">
          Independent technical assurance for founders and investors. One named
          expert, a defined scope, and a written report you can act on.
        </p>
      </div>
      <nav class="footer__col" aria-label="Services">
        <span class="footer__heading">Services</span>
        <a href="/services/technical-due-diligence/">Technical due diligence</a>
        <a href="/services/ai-readiness-review/">AI readiness review</a>
        <a href="/services/ai-code-audit/">AI-built app audit</a>
      </nav>
      <nav class="footer__col" aria-label="Practice">
        <span class="footer__heading">Practice</span>
        <a href="/how-it-works/">How it works</a>
        <a href="/about/">About Henry</a>
        <a href="/writing/">Writing</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
    <div class="footer__legal">
      <span>© {year} Async Forest Advisory Ltd. Registered in England &amp; Wales.</span>
      <span>Reports contain technical observations, not legal advice.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-dark);
    color: var(--gray-400);
    padding-block: var(--space-16) var(--space-8);
    border-top: 1px solid var(--gray-800);
  }
  .footer :global(.logo) { color: var(--gray-50); }
  .footer :global(.logo__descriptor) { color: var(--gray-500); }
  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--gray-800);
  }
  .footer__strap {
    margin-top: var(--space-6);
    font-size: var(--text-base);
    color: var(--gray-500);
    max-width: 36ch;
  }
  .footer__col { display: flex; flex-direction: column; gap: var(--space-3); }
  .footer__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gray-600);
    margin-bottom: var(--space-2);
  }
  .footer__col a {
    color: var(--gray-400);
    text-decoration: none;
    font-size: var(--text-base);
  }
  .footer__col a:hover { color: var(--gray-50); }
  .footer__legal {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--gray-600);
  }
  @media (max-width: 720px) {
    .footer__top { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
