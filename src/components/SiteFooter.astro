---
import { BOOKING_URL } from '../consts';
// Quiet, single-column footer. Carries the Companies Act disclosure line —
// a legal requirement, not decoration. The tree mark already appears in the
// header; per STYLESEED.md it appears once per page, so no logo here.
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__practice">
      Async Forest is the consulting practice of Henry Franks. Engagements are
      contracted with Async Forest Ltd.
    </p>
    <p class="footer__links">
      <a href={BOOKING_URL} target="_blank" rel="noopener">Book a call</a>
    </p>
    <p class="footer__legal">
      Async Forest Ltd, registered in England and Wales, company no.
      [COMPANY NUMBER SLOT]. Registered office: [REGISTERED OFFICE SLOT].
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-y);
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-warm);
    padding-block: var(--space-10);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .footer__practice {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: none;
  }
  .footer__links {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .footer__links a { color: var(--text-muted); }
  .footer__links a:hover { color: var(--text-strong); }
  .footer__legal {
    color: var(--text-muted);
    font-size: var(--text-xs);
    max-width: none;
  }
</style>
