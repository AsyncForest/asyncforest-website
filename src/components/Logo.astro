---
// The Async Forest mark: a fir silhouette divided into three flush horizontal
// thirds, each rendered in a different state — hatched, pixelated, solid —
// stepping through the accent variants top to bottom (accent → hover → active).
// A second tree sits behind in a flat accent-border tint, offset up-right and
// knocked out around the front silhouette, so the mark reads as a forest.
// Per STYLESEED.md this motif appears once per page (header/footer lockup),
// so the SVG ids below are safe as static values.
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 28, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg
    width={(size * 38) / 32}
    height={(size * 34) / 32}
    viewBox="0 0 38 34"
    aria-hidden="true"
  >
    <defs>
      <clipPath id="af-mark-clip">
        <path d="M17 2.5 L29.5 30 L4.5 30 Z" />
        <rect x="15.6" y="30" width="2.8" height="3.2" />
      </clipPath>
      <mask id="af-mark-knock" maskUnits="userSpaceOnUse" x="0" y="0" width="38" height="34">
        <rect width="38" height="34" fill="#fff" />
        <path d="M17 2.5 L29.5 30 L4.5 30 Z" fill="#000" stroke="#000" stroke-width="2.4" stroke-linejoin="round" />
        <rect x="15.6" y="30" width="2.8" height="3.2" fill="#000" stroke="#000" stroke-width="2.4" />
      </mask>
      <pattern id="af-mark-hatch" width="2.4" height="2.4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="1.05" height="2.4" fill="var(--accent)" />
      </pattern>
      <pattern id="af-mark-px" width="3.2" height="3.2" patternUnits="userSpaceOnUse">
        <rect x="0" y="0" width="1.6" height="1.6" fill="var(--accent-hover)" />
        <rect x="1.6" y="1.6" width="1.6" height="1.6" fill="var(--accent-hover)" />
      </pattern>
    </defs>
    <path d="M21 1 L33.5 28.5 L8.5 28.5 Z" fill="var(--accent-border)" mask="url(#af-mark-knock)" />
    <g clip-path="url(#af-mark-clip)">
      <rect x="0" y="2.5" width="38" height="9.1" fill="url(#af-mark-hatch)" />
      <rect x="0" y="11.6" width="38" height="9.3" fill="url(#af-mark-px)" />
      <rect x="0" y="20.9" width="38" height="12.3" fill="var(--accent-active)" />
    </g>
  </svg>
  {wordmark && (
    <span class="logo__text">
      <span class="logo__name">Async Forest</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-strong);
  }
  .logo__text {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .logo__name {
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
  }
</style>
